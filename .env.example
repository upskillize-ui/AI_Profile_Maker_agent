# ═══════════════════════════════════════════════
# UPSKILLIZE PROFILE AGENT v3 — ENVIRONMENT
# ═══════════════════════════════════════════════
#
# ⚠️  SECURITY RULES:
#   1. Copy this file to .env and fill in YOUR values
#   2. NEVER commit .env to git
#   3. NEVER share .env in zip files
#   4. NEVER put real credentials in this .env.example file
#   5. The .gitignore blocks .env — do NOT remove that rule
#
# ═══════════════════════════════════════════════

# Database — your MySQL connection
# Replace with YOUR Aiven/local database URL
DATABASE_URL=mysql+pymysql://username:password@hostname:port/database_name
# Actual Sonnet model IDs are currently set in the agent source files.
# Never put an AI provider key in this example; set ANTHROPIC_API_KEY via secrets.

# Redis
REDIS_URL=redis://localhost:6379/0


# JWT Secret — MUST match your Node.js LMS backend JWT_SECRET
# Generate a strong random string: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_YOUR_ACTUAL_JWT_SECRET

# App
# BASE_URL=https://upskillize.com
# PROFILE_URL_PREFIX=https://upskillize.com/profile
DEBUG=false

# Email Notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@upskillize.com
MAIL_PASSWORD=REPLACE_WITH_APP_PASSWORD
MAIL_FROM=noreply@upskillize.com

BASE_URL=https://upskill25-ai-enhancer.hf.space
PROFILE_URL_PREFIX=https://upskill25-ai-enhancer.hf.space/api/v1/profile/public

# ── Generation admission control (v5.1) ─────────────────────────────
# Pipelines running truly in parallel (keep modest — AI + DB bound):
MAX_PARALLEL_GENERATIONS=8
# Students admitted at once (running + waiting). Student #N+1 gets the
# polite "agent is occupied" message instead of crashing the Space:
GENERATION_WAITING_ROOM=200
# Max seconds an admitted request waits for a running slot before it
# also gets the polite message (keep below proxy timeout ~60s):
GENERATION_WAIT_SECONDS=55
# Every regenerate overwrites the stored profile with the latest result
# (empty/failed collections are still protected). Set false to restore
# the old 70%-richness keep-old-data guard:
REGEN_ALWAYS_OVERWRITE=true
# ProfileIQ has optional paid Claude summary/polishing paths.
# Configure ANTHROPIC_API_KEY only in secure local/staging/host secrets.
# If unset, the existing rule-based fallback is used.

# Secure student-card images: exact HTTPS hostnames only, comma-separated.
# Empty means REMOTE PROFILE PHOTOS ARE BLOCKED (initials fallback).
PROFILE_IMAGE_ALLOWED_HOSTS=

# External resume PDFs: 6 MiB, 30 pages by default.
# Strict mode refuses unknown resume hosts and requires allowlist setup.
# Validate student-upload hostnames in staging before switching to true.
RESUME_HOST_ALLOWLIST=
PROFILE_STRICT_RESUME_HOSTS=false
PROFILE_MAX_RESUME_BYTES=6291456
PROFILE_MAX_RESUME_PAGES=30

# Best-effort LinkedIn lookup upper bounds (seconds).
PROFILE_LINKEDIN_DIRECT_SECONDS=3
PROFILE_LINKEDIN_SEARCH_SECONDS=2
